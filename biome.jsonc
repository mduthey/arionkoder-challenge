{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": [
			"backend/src/**",
			"backend/*.ts",
			"backend/*.json",
			"frontend/src/**",
			"frontend/*.ts",
			"frontend/*.json",
			"*.json",
			"*.jsonc",
			"!backend/drizzle",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"css": {
		"parser": {
			// Tailwind v4 config lives in CSS (`@theme`, `@source`, `@custom-variant`); without this Biome
			// reads those directives as syntax errors.
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"arrowParentheses": "asNeeded"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			// Nursery rule: re-check this key whenever the Biome pin moves. If the rule leaves nursery and this key
			// stays behind, it silently stops being enforced. Fastify handlers, AI SDK calls and TanStack mutations
			// are all promises.
			"nursery": {
				"noFloatingPromises": "error"
			}
		}
	},
	"overrides": [
		{
			// Generated by shadcn: formatted, not linted.
			"includes": ["frontend/src/components/ui/**"],
			"linter": {
				"enabled": false
			}
		}
	]
}
